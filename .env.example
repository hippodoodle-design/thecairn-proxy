# ---- Supabase ----
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key (worker uses this to insert into stones bypassing RLS).
# NEVER expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase -> Settings -> API -> JWT Settings.
# Web uses this to verify user access tokens from the frontend.
SUPABASE_JWT_SECRET=

# ---- ElevenLabs (the Cairn's voices / TTS — voice-out) ----
# Server-side only. The key never reaches the browser; the frontend POSTs text to
# /api/roberta-voice/speak and gets audio back. In prod this is provisioned via
# Buddy (credential `elevenlabs-api-key-thecairn`); this env var is the fallback.
# Spend is balance-limited — keep an eye on /api/roberta-voice/balance.
# ONE key, TWO voices: pass {character:'roberta'|'bertie'} to /speak. Voice ids are
# locked in code (CAIRN_VOICES) — Roberta the companion, Bertie the butler — so no
# voice config is needed here. See docs/bertie-voice-and-persona.md.
ELEVENLABS_API_KEY=

# ---- Roberta's BRAIN (the conversational reply step — voice-in → reply) ----
# Cheap-but-warm by design: Roberta's replies are gentle and in-character, not
# frontier reasoning, so she runs on a Haiku-class model. DEFAULTS need NO new
# config — she reuses the already-provisioned OpenAI key (above) with gpt-4o-mini.
# Override to move her to any low-cost provider/model WITHOUT a code change:
#   ROBERTA_BRAIN_PROVIDER=openai        # or: openrouter
#   ROBERTA_BRAIN_MODEL=gpt-4o-mini      # or e.g. anthropic/claude-3.5-haiku on OpenRouter
#   OPENROUTER_API_KEY=                  # only needed when provider=openrouter
# Output is token-capped per turn and every reply returns usage + a costUsd
# estimate (see /api/roberta-brain/chat) so spend can be metered to user credits.
ROBERTA_BRAIN_PROVIDER=openai
ROBERTA_BRAIN_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
# The brain ALSO returns Roberta's voice inline (base64 mp3) so the frontend holds
# no voice key. Set to `off` to return text-only (the FE then uses free browser
# speech). Voice-out is balance-limited; common lines are cached per process.
ROBERTA_BRAIN_TTS=on
# Preview metering (a simple counter for the test phase; full credit wiring later).
# turnCost = LLM token cost + an ElevenLabs char-based estimate; creditsLeft draws
# down this notional pot so the FE can surface a number.
ROBERTA_PREVIEW_CREDIT_USD=5
ELEVENLABS_USD_PER_CHAR=0.00018

# ---- Redis / BullMQ ----
# Railway provides this in prod. Local dev: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ---- Web service ----
PORT=3001
NODE_ENV=development

# Comma-separated allowlist. Defaults to:
# https://www.thecairn.app,https://thecairn.app,http://localhost:5173
ALLOWED_ORIGINS=https://www.thecairn.app,https://thecairn.app,http://localhost:5173
# Optional opt-in regex for ephemeral PREVIEW origins (the thecairn-app First-Taste
# preview is a *.vercel.app domain whose hash rotates per push, so it can't be
# pinned above). Set this on the PREVIEW deploy ONLY; leave it UNSET in production.
# Example (matches the hippodoodle-designs preview project):
# ALLOWED_ORIGIN_REGEX=^https://thecairn-[a-z0-9]+-hippodoodle-designs-projects\.vercel\.app$
ALLOWED_ORIGIN_REGEX=
