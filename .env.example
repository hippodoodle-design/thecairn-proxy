# ---- Supabase ----
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key (worker uses this to insert into stones bypassing RLS).
# NEVER expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase -> Settings -> API -> JWT Settings.
# Web uses this to verify user access tokens from the frontend.
SUPABASE_JWT_SECRET=

# ---- Redis / BullMQ ----
# Railway provides this in prod. Local dev: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ---- Web service ----
PORT=3001
NODE_ENV=development

# Comma-separated allowlist. Defaults to:
# https://www.thecairn.app,https://thecairn.app,http://localhost:5173
# (Vercel previews under the hippodoodle-designs org are allowed automatically.)
ALLOWED_ORIGINS=https://www.thecairn.app,https://thecairn.app,http://localhost:5173

# ---- Speak-to-Roberta brain (POST /api/roberta/brain) ----
# LLM brain reuses the existing OpenAI credential (OPENAI_API_KEY above /
# openai-api-key-thecairn in Buddy). Cheap-but-warm model; override to swap:
CAIRN_BRAIN_MODEL=gpt-4o-mini
# ElevenLabs server-side voice-out for Roberta. Key NEVER ships to the client.
# Buddy name: elevenlabs-api-key-thecairn. Endpoint degrades to text-only if absent.
ELEVENLABS_API_KEY=
# Roberta's locked voice id (bible d6a80e2b). Override only for safety testing.
CAIRN_ROBERTA_VOICE_ID=h8eW5xfRUGVJrZhAFxqK
# Set to 'false' to disable server-side TTS globally (text-only replies).
CAIRN_TTS_ENABLED=true
